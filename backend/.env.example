# AccessAudit backend configuration.
# Copy to backend/.env and adjust if needed. Never commit real .env files.

# Port the API listens on (must match VITE_API_BASE_URL in the frontend .env).
PORT=8000

# Comma-separated list of browser origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where scan records are stored (JSON file). Relative paths resolve from backend/.
DATA_DIR=./data

# Bounded timeouts (milliseconds) so scans cannot hang indefinitely.
NAVIGATION_TIMEOUT_MS=30000
SCAN_TIMEOUT_MS=60000

# Resource limits.
MAX_CONCURRENT_SCANS=2
MAX_QUEUE_LENGTH=20

# Rate limit for POST /api/scans per IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_SCANS=20

# TEST ONLY — allows scanning loopback targets (127.0.0.1 / localhost) so the
# automated test suite can scan a controlled local fixture page.
# NEVER set this to true on a shared or publicly reachable deployment.
ALLOW_LOCAL_TARGETS=false
